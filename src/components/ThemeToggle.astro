---
import { getLangFromUrl, useTranslations } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<button
  class="theme-toggle"
  id="theme-toggle"
  type="button"
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
>
  <span class="knob" aria-hidden="true">
    <svg class="ico ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.4v2M12 19.6v2M2.4 12h2M19.6 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
    </svg>
    <svg class="ico ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.5 14.3A8.6 8.6 0 1 1 9.7 3.5a6.9 6.9 0 0 0 10.8 10.8Z"></path>
    </svg>
  </span>
</button>

<style>
  .theme-toggle {
    --w: 50px; --h: 27px; --pad: 3px;
    width: var(--w); height: var(--h);
    padding: 0; flex: none;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-light);
    background: var(--bg-inset);
    position: relative; cursor: pointer;
    transition: background 0.24s var(--ease), border-color 0.24s var(--ease);
  }
  .theme-toggle:hover { border-color: var(--text-mute); }

  .knob {
    position: absolute; top: var(--pad); left: var(--pad);
    width: calc(var(--h) - var(--pad) * 2 - 2px);
    height: calc(var(--h) - var(--pad) * 2 - 2px);
    border-radius: 50%;
    background: var(--bg-elev);
    box-shadow: var(--shadow-sm);
    display: grid; place-items: center;
    transition: translate 0.28s var(--ease), background 0.24s var(--ease);
  }
  :global([data-theme='light']) .knob {
    translate: calc(var(--w) - var(--h)) 0;
    background: var(--brand);
    color: #fff;
  }

  .ico {
    grid-area: 1 / 1; width: 13px; height: 13px;
    transition: opacity 0.2s var(--ease), rotate 0.3s var(--ease), scale 0.2s var(--ease);
  }
  .ico-sun  { opacity: 0; rotate: -70deg; scale: 0.5; }
  .ico-moon { opacity: 1; color: var(--text-dim); }
  :global([data-theme='light']) .ico-sun  { opacity: 1; rotate: 0deg; scale: 1; color: #fff; }
  :global([data-theme='light']) .ico-moon { opacity: 0; rotate: 70deg; scale: 0.5; }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = '1';
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      root.style.colorScheme = next;
      try { localStorage.setItem('gp-theme', next); } catch (e) {}
      // Let embedded widgets (charts, sparklines) restyle themselves.
      window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
    });
  })();
</script>
