---
import { SITE } from '../config';

export interface Props {
  slot?: keyof typeof SITE.adsense.slots;
  format?: string;
  layout?: string;
  class?: string;
}

const { slot = 'inArticle', format = 'auto', layout, class: className = '' } = Astro.props;
const ads = SITE.adsense;
const slotId = ads.slots[slot];
const live = ads.enabled && ads.clientId && slotId;
---

{live ? (
  <div class={`ad-slot ${className}`} data-placeholder>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ads.clientId}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-ad-layout={layout}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : (
  /* Renders nothing until AdSense is configured, so the pre-approval site
     ships with no empty ad containers — a common rejection trigger. */
  <Fragment />
)}
