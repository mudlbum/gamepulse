---
import { SITE } from '../config';
import { alternatePath, absolute } from '../lib/paths';
import type { Lang } from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** 'website' | 'article' */
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  section?: string;
  tags?: string[];
  noindex?: boolean;
  /** Also stop crawlers following outbound links. Only right for real dead ends. */
  nofollow?: boolean;
  /** Extra JSON-LD graph nodes to merge into the page's @graph. */
  schema?: Record<string, unknown>[];
  /** Question/answer pairs — emitted as FAQPage and highly quotable by AI engines. */
  faq?: { q: string; a: string }[];
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description,
  lang,
  type = 'website',
  image,
  imageAlt,
  publishedTime,
  modifiedTime,
  author = SITE.author.name,
  section,
  tags = [],
  noindex = false,
  nofollow = false,
  schema = [],
  faq = [],
  breadcrumbs = [],
} = Astro.props;

const siteOrigin = Astro.site?.origin ?? SITE.url;
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', siteOrigin).toString();

const enPath = alternatePath(Astro.url.pathname, 'en');
const koPath = alternatePath(Astro.url.pathname, 'ko');
const enUrl = new URL(enPath, siteOrigin).toString();
const koUrl = new URL(koPath, siteOrigin).toString();

/* `new URL('/x', origin)` silently discards the base path, so on a project
   site (/repo/) every one of these resolved to the domain root and 404'd.
   absolute() prefixes BASE_URL before joining. */
const ogImage = image
  ? image.startsWith('http')
    ? image
    : image.startsWith(import.meta.env.BASE_URL)
      ? new URL(image, siteOrigin).toString() // already base-prefixed by Astro's asset pipeline
      : absolute(image, siteOrigin)
  : absolute('/og-default.png', siteOrigin);

/* Google truncates meta descriptions around 160 characters. Individual pages
   kept drifting past it (the Steam game pages were reaching 195), so the clamp
   lives here rather than in fifteen call sites — cut on a word boundary, never
   mid-word, and only when it is actually too long. */
const MAX_DESC = 158;
const metaDescription = (() => {
  const d = description.trim();
  if (d.length <= MAX_DESC) return d;
  const cut = d.slice(0, MAX_DESC);
  const at = Math.max(cut.lastIndexOf(' '), cut.lastIndexOf('. '));
  return (at > MAX_DESC * 0.6 ? cut.slice(0, at) : cut).replace(/[,.;:\s]+$/, '') + '…';
})();

const fullTitle = title === SITE.name ? `${SITE.name} — ${SITE.tagline[lang]}` : `${title} | ${SITE.name}`;
const locale = lang === 'ko' ? 'ko_KR' : 'en_US';

/* ---------- JSON-LD graph ---------- */
// The site's own root, base path included — not just the origin.
const siteRoot = absolute('/', siteOrigin);
const orgId = `${siteRoot}#organization`;
const siteId = `${siteRoot}#website`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: SITE.name,
    url: siteRoot,
    description: SITE.description[lang],
    logo: { '@type': 'ImageObject', url: absolute('/logo.png', siteOrigin), width: 512, height: 512 },
    // Omitted entirely when there are no profiles — an empty sameAs array is a
    // validator warning and tells Google nothing.
    ...(Object.values(SITE.social).filter(Boolean).length
      ? { sameAs: Object.values(SITE.social).filter(Boolean) }
      : {}),
  },
  {
    '@type': 'WebSite',
    '@id': siteId,
    url: siteRoot,
    name: SITE.name,
    description: SITE.description[lang],
    publisher: { '@id': orgId },
    inLanguage: lang === 'ko' ? 'ko-KR' : 'en-US',
    /* No SearchAction. It used to advertise /search?q= — a page that does not
       exist and that robots.txt disallows. Declaring a sitelinks search box for
       a missing endpoint is a structured-data error, not a free feature. Add it
       back the same day a real search page ships. */
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: fullTitle,
    description: metaDescription,
    isPartOf: { '@id': siteId },
    inLanguage: lang === 'ko' ? 'ko-KR' : 'en-US',
    ...(modifiedTime ? { dateModified: new Date(modifiedTime).toISOString() } : {}),
    ...(publishedTime ? { datePublished: new Date(publishedTime).toISOString() } : {}),
  },
];

if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: breadcrumbs.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: b.url.startsWith('http') ? b.url : new URL(b.url, siteOrigin).toString(),
    })),
  });
}

if (faq.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

graph.push(...schema);

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />

<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="ko" href={koUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

{/* noindex does NOT imply nofollow. A thin game page should still pass crawlers
    along to the related games and the games index it links to; only a genuine
    dead end like /404 deserves nofollow. */}
{noindex
  ? <meta name="robots" content={`noindex, ${nofollow ? 'nofollow' : 'follow'}`} />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={new Date(modifiedTime).toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={author} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
