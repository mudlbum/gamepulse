---
import Sparkline from './Sparkline.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { formatNumber, formatCompact, localeHref } from '../lib/paths';
import { gameSlug } from '../lib/games';

export interface Props {
  entries: any[];
  limit?: number;
  compact?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { entries = [], limit, compact = false } = Astro.props;
const rows = limit ? entries.slice(0, limit) : entries;
---

<div class="table-wrap">
  <table data-leaderboard class:list={{ compact }}>
    <caption class="sr-only">{t('lb.title')}</caption>
    <thead>
      <tr>
        <th scope="col" style="width:3.5rem">{t('lb.rank')}</th>
        <th scope="col">{t('lb.game')}</th>
        <th scope="col" class="num">{t('lb.players')}</th>
        {!compact && <th scope="col" class="num hide-sm">{t('lb.peak')}</th>}
        {/* Compact mode lives in a ~460px sidebar. Viewport media queries
            cannot see that, so these columns are dropped outright rather than
            hidden responsively — otherwise the table overflows its card. */}
        {!compact && <th scope="col" class="num hide-sm">{t('lb.change')}</th>}
        {!compact && <th scope="col" class="hide-md" style="width:90px">{t('lb.trend')}</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((e) => (
        <tr data-appid={e.appid}>
          <td class="rank-cell" data-top={e.rank <= 3 ? e.rank : undefined}>
            {e.rank}
            {e.rankChange != null && e.rankChange !== 0 && (
              <span class={e.rankChange > 0 ? 'text-up delta' : 'text-down delta'}>
                {e.rankChange > 0 ? '▲' : '▼'}{Math.abs(e.rankChange)}
              </span>
            )}
          </td>
          <td>
            {/* Apps whose store metadata has not resolved yet are named
                "App 12345" and get no page, so they must not be linked. */}
            {/^App \d+$/.test(e.name) ? (
              <span class="game">
                <img src={e.image} alt="" width="46" height="21" loading="lazy" decoding="async" />
                <span class="game-name text-mute">{e.name}</span>
              </span>
            ) : (
              <a class="game" href={localeHref(`/games/${gameSlug(e.name)}`, lang)}>
                <img src={e.image} alt="" width="46" height="21" loading="lazy" decoding="async" />
                <span class="game-name">{e.name}</span>
                {e.free && <span class="badge badge-brand hide-sm">F2P</span>}
              </a>
            )}
          </td>
          <td class="num players" data-players={e.current}>{formatNumber(e.current, lang)}</td>
          {!compact && <td class="num hide-sm text-mute">{e.peak ? formatCompact(e.peak, lang) : '—'}</td>}
          {!compact && (
            <td class="num hide-sm">
              {e.change24h == null ? (
                <span class="text-mute">—</span>
              ) : (
                <span class={e.change24h >= 0 ? 'text-up' : 'text-down'}>
                  {e.change24h >= 0 ? '+' : ''}{e.change24h.toFixed(1)}%
                </span>
              )}
            </td>
          )}
          {!compact && (
            <td class="hide-md">
              <Sparkline values={e.spark ?? []} label={`${e.name} 7-day player trend`} />
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .game { display: flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--text); min-width: 0; }
  .game:hover .game-name { color: var(--brand); }
  .game img { width: 46px; height: 21px; object-fit: cover; border-radius: 3px; flex: none; background: var(--bg-inset); }
  .game-name { font-weight: 560; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .players { font-weight: 620; }
  .delta { font-size: 0.62rem; margin-left: 0.2em; font-weight: 600; }
  @media (max-width: 640px) { .game-name { max-width: 42vw; } }

  /* Compact mode sits in a fixed-width card, not a full-width page, so the
     name column has to yield instead of pushing the numeric column out of
     view. table-layout:fixed lets the 1fr name cell actually shrink —
     without it the nowrap title sets the table's minimum width. */
  table.compact { table-layout: fixed; width: 100%; }
  table.compact th:first-child, table.compact td:first-child { width: 2.6rem; }
  table.compact th:last-child, table.compact td:last-child { width: 6.2rem; }
  table.compact thead th { font-size: 0.66rem; letter-spacing: 0.05em; }
  table.compact thead th,
  table.compact tbody td { padding-inline: var(--space-3); }
  table.compact .game { min-width: 0; }
  table.compact .game-name { min-width: 0; flex: 1; }
</style>

<script is:inline>
  /* Repaint player counts in place when a poll brings fresher numbers, with a
     brief colour flash so a change is noticeable without being distracting. */
  (function () {
    var table = document.querySelector('[data-leaderboard]');
    if (!table || table.dataset.bound) return;
    table.dataset.bound = '1';
    var fmt = new Intl.NumberFormat(document.documentElement.lang.startsWith('ko') ? 'ko-KR' : 'en-US');

    window.addEventListener('livedata', function (ev) {
      if (ev.detail.dataset !== 'leaderboard') return;
      var entries = ev.detail.data.entries || [];
      for (var i = 0; i < entries.length; i++) {
        var e = entries[i];
        var cell = table.querySelector('tr[data-appid="' + e.appid + '"] .players');
        if (!cell) continue;
        var prev = Number(cell.dataset.players || 0);
        if (prev === e.current) continue;
        cell.dataset.players = String(e.current);
        cell.textContent = fmt.format(e.current);
        cell.classList.remove('flash-up', 'flash-down');
        void cell.offsetWidth; // restart the animation
        cell.classList.add(e.current > prev ? 'flash-up' : 'flash-down');
      }
    });
  })();
</script>
