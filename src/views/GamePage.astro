---
import Sparkline from '../components/Sparkline.astro';
import ClipCard from '../components/ClipCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { localeHref, formatNumber, formatCompact, formatDate, relativeTime } from '../lib/paths';
import { noRankingReason } from '../lib/games';
import type { GameEntry } from '../lib/games';

export interface Props { game: GameEntry }
const { game } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const ko = lang === 'ko';

const s = game.steam;
const sr = game.speedrun;
const platformLabel: Record<string, string> = {
  pc: 'PC', playstation: 'PlayStation', xbox: 'Xbox', switch: 'Switch', mobile: 'Mobile', vr: 'VR',
};
const monthDay = (d: string) => formatDate(d, lang);

const stores = Object.values<any>(game.mobile ?? {});

/* Derived from the 8-day series we already hold — no extra fetch, and it is the
   context a bare "playing now" number is missing. */
const spark: number[] = s?.spark ?? [];
const high = spark.length ? Math.max(...spark) : null;
const low = spark.length ? Math.min(...spark) : null;
const avg = spark.length ? Math.round(spark.reduce((a, b) => a + b, 0) / spark.length) : null;

const facts: { k: string; v: string }[] = [];
if (s?.developers?.length) facts.push({ k: ko ? '개발사' : 'Developer', v: s.developers.join(', ') });
if (stores[0]?.artist && !s) facts.push({ k: ko ? '퍼블리셔' : 'Publisher', v: stores[0].artist });
if (s?.releaseDate) facts.push({ k: ko ? '출시' : 'Released', v: s.releaseDate });
else if (stores[0]?.releaseDate)
  facts.push({ k: ko ? '출시' : 'Released', v: formatDate(stores[0].releaseDate, lang) });
if (s?.genres?.length) facts.push({ k: ko ? '장르' : 'Genres', v: s.genres.join(', ') });
if (s) facts.push({ k: ko ? '가격' : 'Price', v: s.free ? (ko ? '무료' : 'Free to play') : (ko ? '유료' : 'Paid') });
else if (stores[0]?.price) facts.push({ k: ko ? '가격' : 'Price', v: stores[0].price });
if (stores[0]?.contentRating) facts.push({ k: ko ? '이용등급' : 'Rated', v: stores[0].contentRating });
if (game.platforms.length)
  facts.push({ k: ko ? '플랫폼' : 'Platforms', v: game.platforms.map((p) => platformLabel[p] ?? p).join(', ') });
// Storefronts agree on version and release notes, so take them from whichever
// entry actually carries them rather than hardcoding 'us' — plenty of these
// games are Korea-only.
const app = stores.find((m: any) => m.releaseNotes) ?? stores[0] ?? null;
const coverSrc = sr?.cover || s?.image || app?.artwork || null;
---

<div class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={localeHref('/', lang)}>{t('nav.home')}</a>
    <span aria-hidden="true">/</span>
    <a href={localeHref('/games', lang)}>{t('nav.games')}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{game.name}</span>
  </nav>

  <header class="game-head">
    {coverSrc && <img class="cover" src={coverSrc} alt="" loading="eager" width="120" height="160" />}
    <div>
      <div class="tags-row">
        {game.platforms.map((p) => <span class="badge">{platformLabel[p] ?? p}</span>)}
        {s?.free && <span class="badge badge-brand">F2P</span>}
      </div>
      <h1>{game.name}</h1>
      {s ? (
        <p class="lede">
          {ko
            ? `스팀 동시접속자 순위 ${s.rank}위, 현재 ${formatNumber(s.current, lang)}명이 플레이 중입니다.`
            : `#${s.rank} on Steam right now with ${formatNumber(s.current, lang)} players in game.`}
        </p>
      ) : app ? (
        <p class="lede">
          {ko
            ? `App Store 누적 평점 ${formatNumber(app.ratings, lang)}개${app.rating ? `, 평균 ${app.rating}점` : ''}. 최신 버전 ${app.version ?? '—'}.`
            : `${formatNumber(app.ratings, lang)} App Store ratings${app.rating ? `, averaging ${app.rating}` : ''}. Current version ${app.version ?? '—'}.`}
        </p>
      ) : null}
      <div class="head-links">
        {s?.url && <a class="btn btn-sm" href={s.url} rel="noopener nofollow" target="_blank">Steam ↗</a>}
        {app?.url && <a class="btn btn-sm" href={app.url} rel="noopener nofollow" target="_blank">App Store ↗</a>}
        {game.patches?.official && (
          <a class="btn btn-sm" href={game.patches.official} rel="noopener nofollow" target="_blank">
            {ko ? '공식 패치노트' : 'Official patch notes'} ↗
          </a>
        )}
        {sr?.boardWeblink && (
          <a class="btn btn-sm" href={sr.boardWeblink} rel="noopener nofollow" target="_blank">speedrun.com ↗</a>
        )}
      </div>
    </div>
  </header>

  {/* ---------- Live Steam numbers ---------- */}
  {s && (
    <section class="mt-6">
      <div class="section-head"><h2>{ko ? '실시간 플레이어' : 'Live players'}</h2></div>
      <div class="stat-row">
        <div class="stat">
          <span class="stat-label">{t('lb.players')}</span>
          <strong class="stat-value">{formatNumber(s.current, lang)}</strong>
        </div>
        <div class="stat">
          <span class="stat-label">{t('lb.peak')}</span>
          <strong class="stat-value">{s.peak ? formatCompact(s.peak, lang) : '—'}</strong>
        </div>
        <div class="stat">
          <span class="stat-label">{t('lb.rank')}</span>
          <strong class="stat-value">#{s.rank}</strong>
          {s.rankChange != null && s.rankChange !== 0 && (
            <span class={s.rankChange > 0 ? 'stat-sub text-up' : 'stat-sub text-down'}>
              {s.rankChange > 0 ? '▲' : '▼'}{Math.abs(s.rankChange)} {ko ? '지난 갱신 대비' : 'since last refresh'}
            </span>
          )}
        </div>
        <div class="stat">
          <span class="stat-label">{t('lb.change')}</span>
          <strong class:list={['stat-value', s.change24h == null ? '' : s.change24h >= 0 ? 'text-up' : 'text-down']}>
            {s.change24h == null ? '—' : `${s.change24h >= 0 ? '+' : ''}${s.change24h.toFixed(1)}%`}
          </strong>
        </div>
      </div>
      {s.spark?.length > 1 && (
        <div class="chart card">
          <span class="chart-label">{ko ? '최근 8일 추이' : 'Last 8 days'}</span>
          <Sparkline values={s.spark} width={640} height={90} label={`${game.name} player trend`} />
          {high != null && (
            <p class="chart-read">
              {ko
                ? `이 기간 최고 ${formatNumber(high, lang)}명, 최저 ${formatNumber(low!, lang)}명, 평균 약 ${formatNumber(avg!, lang)}명입니다. 현재 접속자는 8일 평균 대비 ${avg ? Math.round(((s.current - avg) / avg) * 100) : 0}% 수준입니다.`
                : `Over this window it peaked at ${formatNumber(high, lang)}, bottomed out at ${formatNumber(low!, lang)} and averaged about ${formatNumber(avg!, lang)}. Right now it is running ${avg ? Math.round(((s.current - avg) / avg) * 100) : 0}% against that 8-day average.`}
            </p>
          )}
        </div>
      )}
    </section>
  )}

  {/* ---------- Facts ---------- */}
  {facts.length > 0 && (
    <section class="mt-6">
      <div class="section-head"><h2>{ko ? '게임 정보' : 'About this game'}</h2></div>
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {/* ---------- App Store ---------- */}
  {stores.length > 0 && (
    <section class="mt-6">
      <div class="section-head">
        <h2>{ko ? 'App Store 지표' : 'App Store metrics'}</h2>
        <span class="badge badge-warn">{ko ? '접속자 수 아님' : 'not a player count'}</span>
      </div>
      <div class="store-grid">
        {stores.map((m: any) => (
          <div class="stat">
            <span class="stat-label">{ko ? m.storeLabelKo ?? m.storeLabel : m.storeLabel}</span>
            <strong class="stat-value">{formatCompact(m.ratings, lang)}</strong>
            <span class="stat-sub">
              {ko ? '누적 평점' : 'lifetime ratings'}
              {m.rating != null && <> · ★ {m.rating}</>}
            </span>
            {/* Truthiness, not != null. A zero reaching this template is a
                measurement we could not make, and "+0 this week" reads as one
                we could. */}
            <span class="stat-sub">
              {m.ratingsPerWeek
                ? ko
                  ? `주간 +${formatCompact(m.ratingsPerWeek, lang)}`
                  : `+${formatCompact(m.ratingsPerWeek, lang)} this week`
                : ko
                  ? '주간 증감 집계 중'
                  : 'weekly change: collecting'}
            </span>
          </div>
        ))}
      </div>
      <p class="fine">
        {ko
          ? '평점 개수는 인기도를 가늠하는 대리 지표입니다. 애플은 플레이어 수를 공개하지 않으며, Google Play는 공개 API가 없어 안드로이드 수치는 포함되지 않습니다.'
          : 'Rating volume is a popularity proxy. Apple publishes no player numbers, and Google Play has no public API, so Android is not reflected here.'}
      </p>
    </section>
  )}

  {/* Mobile release notes are the only patch notes these games publish in a
      machine-readable form, so they get the same treatment as Steam's. */}
  {app?.releaseNotes && (
    <section class="mt-6">
      <div class="section-head"><h2>{ko ? '최신 버전 변경사항' : "What's new in this version"}</h2></div>
      <div class="card release-notes">
        <div class="patch-top">
          {app.version && <span class="badge badge-brand">{app.version}</span>}
          {app.versionDate && <time datetime={app.versionDate}>{relativeTime(app.versionDate, lang)}</time>}
        </div>
        <p>{app.releaseNotes}</p>
        {app.url && (
          <a href={app.url} rel="noopener nofollow" target="_blank">
            {ko ? 'App Store에서 보기' : 'View on the App Store'} ↗
          </a>
        )}
      </div>
    </section>
  )}

  {/* No ad on a page thin enough to be noindexed. AdSense's own policy asks for
      ads to sit beside publisher content, and a stub is exactly where an ad
      looks like the reason the page exists. */}
  {!game.thin && <AdSlot slot="inArticle" />}

  {/* ---------- Player ranking ---------- */}
  <section class="mt-7">
    <div class="section-head">
      <h2>{ko ? '플레이어 순위' : 'Player leaderboard'}</h2>
      {sr && <span class="badge badge-brand">{sr.category}</span>}
    </div>

    {sr ? (
      <>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col" style="width:3.5rem">#</th>
                <th scope="col">{ko ? '주자' : 'Runner'}</th>
                <th scope="col" class="num">{ko ? '기록' : 'Time'}</th>
                <th scope="col" class="hide-sm">{ko ? '날짜' : 'Date'}</th>
                <th scope="col" class="hide-sm" style="width:5rem">{ko ? '영상' : 'Video'}</th>
              </tr>
            </thead>
            <tbody>
              {sr.runs.map((r: any) => (
                <tr>
                  <td class="rank-cell" data-top={r.place <= 3 ? r.place : undefined}>{r.place}</td>
                  <td>
                    {r.players.map((p: any, i: number) => (
                      <>
                        {i > 0 && <span class="text-mute">, </span>}
                        {p.url ? (
                          <a href={p.url} rel="noopener nofollow" target="_blank">{p.name}</a>
                        ) : (
                          <span>{p.name}</span>
                        )}
                        {p.guest && <span class="badge guest">guest</span>}
                      </>
                    ))}
                  </td>
                  <td class="num mono"><strong>{r.time}</strong></td>
                  <td class="hide-sm text-mute">{r.date ? formatDate(r.date, lang) : '—'}</td>
                  <td class="hide-sm">
                    {r.video ? (
                      <a href={r.video} rel="noopener nofollow" target="_blank">▶ {ko ? '보기' : 'Watch'}</a>
                    ) : (
                      <span class="text-mute">—</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {sr.hasTies && (
          <p class="fine">{ko ? '동일 순위(동률)가 포함되어 있습니다.' : 'This board contains tied placements.'}</p>
        )}
        <p class="attribution">
          {ko ? '기록 데이터 제공: ' : 'Run data from '}
          <a href={sr.boardWeblink ?? 'https://www.speedrun.com/'} rel="noopener" target="_blank">speedrun.com</a>
          {ko ? ' — CC BY-NC 4.0 라이선스에 따라 출처를 표기합니다.' : ', used under CC BY-NC 4.0 with attribution.'}
          {sr.timing && <> {ko ? '계측 방식' : 'Timed by'}: <code>{sr.timing}</code>.</>}
        </p>
      </>
    ) : (
      <aside class="callout no-rank">
        <p class="callout-title">{ko ? '공개된 순위 없음' : 'No public ranking available'}</p>
        <p>{noRankingReason(game.name, lang, !s && stores.length > 0)}</p>
      </aside>
    )}
  </section>

  {/* ---------- Patch notes ---------- */}
  {game.patches?.entries?.length > 0 && (
    <section class="mt-7">
      <div class="section-head"><h2>{ko ? '최근 업데이트' : 'Recent updates'}</h2></div>
      <ul role="list" class="patches">
        {game.patches.entries.slice(0, 8).map((e: any) => (
          <li>
            <div class="patch-top">
              {e.version && <span class="badge badge-brand">{e.version}</span>}
              {e.date && <time datetime={e.date}>{relativeTime(e.date, lang)}</time>}
            </div>
            <a href={e.url} rel="noopener nofollow" target="_blank">{e.title}</a>
            {e.summary && <p class="clamp-2">{e.summary}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ---------- Clips ---------- */}
  {game.clips.length > 0 && (
    <section class="mt-7">
      <div class="section-head"><h2>{ko ? '관련 영상' : 'Clips mentioning this game'}</h2></div>
      <div class="grid grid-auto">
        {game.clips.map((c: any) => <ClipCard clip={c} />)}
      </div>
    </section>
  )}

  {/* ---------- Coverage ---------- */}
  {game.news.length > 0 && (
    <section class="mt-7">
      <div class="section-head"><h2>{ko ? '이 게임 관련 보도' : 'Coverage mentioning this game'}</h2></div>
      <ul role="list" class="coverage">
        {game.news.map((c: any) => (
          <li>
            <a href={(c.articles?.[0]?.url) ?? c.url} rel="noopener nofollow" target="_blank">
              {c.headline ?? c.title}
            </a>
            <span class="src-line">
              {(c.outlets ?? [c.outlet]).filter(Boolean).slice(0, 3).join(' · ')}
              {c.outletCount > 3 && ` +${c.outletCount - 3}`}
              {(c.newest ?? c.date) && <> · <time datetime={c.newest ?? c.date}>{relativeTime(c.newest ?? c.date, lang)}</time></>}
            </span>
          </li>
        ))}
      </ul>
      <p class="fine">
        {ko
          ? '외부 매체 헤드라인입니다. 링크는 원문으로 연결되며, 본 사이트가 작성한 기사가 아닙니다.'
          : 'Headlines from other outlets. Links go to the original reporting; these are not our articles.'}
      </p>
    </section>
  )}

  {/* ---------- Related games ---------- */}
  {game.related.length > 0 && (
    <section class="mt-7">
      <div class="section-head"><h2>{ko ? '비슷한 게임' : 'Related games'}</h2></div>
      <ul role="list" class="related">
        {game.related.map((r) => (
          <li>
            <a href={localeHref(`/games/${r.slug}`, lang)}>
              <strong>{r.name}</strong>
              <span>
                {r.steam
                  ? ko ? `${formatCompact(r.steam.current, lang)}명 접속 중` : `${formatCompact(r.steam.current, lang)} playing`
                  : r.platforms.map((p) => platformLabel[p] ?? p).join(' · ')}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ---------- Methodology ----------
      Per-page, not boilerplate: it names the endpoints this specific game's
      numbers came from and what is missing for it. Readers can check us, and
      it is the difference between a data page and an unsourced claim. */}
  <aside class="callout method mt-7">
    <p class="callout-title">{ko ? '이 수치의 출처' : 'Where these numbers come from'}</p>
    <ul>
      {s && (
        <li>
          {ko
            ? '접속자 수는 밸브의 공개 ISteamChartsService 엔드포인트에서 30분마다 가져옵니다. 스팀 동시접속자만 집계되며, 콘솔·에픽·게임패스 플레이어는 포함되지 않습니다 — 어느 플랫폼사도 동등한 실시간 수치를 공개하지 않습니다.'
            : "Player counts come from Valve's public ISteamChartsService endpoint, refreshed every 30 minutes. They are Steam concurrents only — console, Epic and Game Pass players are not included, because no platform holder publishes a comparable live figure."}
        </li>
      )}
      {stores.length > 0 && (
        <li>
          {ko
            ? 'App Store 수치는 애플의 공개 iTunes Lookup API에서 가져온 누적 평점 개수입니다. 인기도 대리 지표이며 접속자 수가 아닙니다. Google Play는 공개 API가 없어 안드로이드는 포함되지 않습니다.'
            : "App Store figures are lifetime rating counts from Apple's public iTunes Lookup API — a popularity proxy, not a player count. Google Play publishes no public API, so Android is not represented."}
        </li>
      )}
      {sr && (
        <li>
          {ko
            ? `스피드런 순위는 speedrun.com의 「${sr.category}」 부문 상위 기록이며, 검증된 제출 기록만 포함됩니다.`
            : `The speedrun table is the top of the "${sr.category}" category on speedrun.com and contains verified submissions only.`}
        </li>
      )}
      {game.patches && (
        <li>
          {ko
            ? `패치 정보는 ${game.patches.method ?? '공식 피드'} 방식으로 수집합니다. 요약은 원문에서 추출한 것이며, 전체 내용은 반드시 공식 노트를 확인하세요.`
            : `Patch entries are collected by ${game.patches.method ?? 'official feed'}. Summaries are extracted from the source — always read the official notes for the full detail.`}
        </li>
      )}
      {!s && !stores.length && !sr && (
        <li>
          {ko
            ? '이 게임에 대해 공개적으로 검증 가능한 실시간 수치가 없어, 패치 정보와 관련 영상만 싣습니다.'
            : 'No publicly verifiable live figure exists for this game, so this page carries patch tracking and related video only.'}
        </li>
      )}
    </ul>
    <p class="src">
      <a href={localeHref('/editorial-policy', lang)}>
        {ko ? '편집 원칙 및 데이터 정책' : 'Editorial policy and data sourcing'}
      </a>
    </p>
  </aside>

  <p class="back mt-7">
    <a href={localeHref('/games', lang)}>← {t('nav.games')}</a>
  </p>
</div>

<style>
  .crumbs { display: flex; gap: 0.5rem; font-size: var(--step--1); color: var(--text-mute); margin-bottom: var(--space-5); flex-wrap: wrap; }
  .crumbs a { color: var(--text-mute); text-decoration: none; }
  .crumbs a:hover { color: var(--brand); }

  .game-head { display: flex; gap: var(--space-5); align-items: flex-start; flex-wrap: wrap; }
  .cover { width: 120px; height: auto; border-radius: var(--radius); border: 1px solid var(--border); flex: none; }
  .game-head h1 { font-size: var(--step-4); margin-block: 0.15em 0.3em; }
  .tags-row { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .head-links { display: flex; gap: var(--space-2); flex-wrap: wrap; margin-top: var(--space-4); }
  .head-links a { text-decoration: none; }

  .stat-row { display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr)); }
  .stat { background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4); display: flex; flex-direction: column; gap: 0.15rem; }
  .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-mute); font-weight: 640; }
  .stat-value { font-size: var(--step-2); font-weight: 700; font-variant-numeric: tabular-nums; }
  .stat-sub { font-size: var(--step--1); color: var(--text-dim); }

  .chart { margin-top: var(--space-4); padding: var(--space-5); }
  .chart:hover { transform: none; }
  .chart-label { display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-mute); font-weight: 640; margin-bottom: var(--space-3); }
  .chart :global(.spark) { width: 100%; height: 90px; }

  .guest { font-size: 0.62rem; margin-left: 0.35em; padding-inline: 0.4em; }
  .fine { font-size: 0.76rem; color: var(--text-mute); margin-top: var(--space-3); }
  .attribution { font-size: 0.78rem; color: var(--text-mute); margin-top: var(--space-4); line-height: 1.6; }
  .no-rank { border-left-color: var(--text-mute); }
  .no-rank .callout-title { color: var(--text-dim); }

  .chart-read { font-size: var(--step--1); color: var(--text-dim); margin-top: var(--space-3); line-height: 1.65; max-width: 74ch; }

  .facts { display: grid; gap: 0; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); margin: 0; }
