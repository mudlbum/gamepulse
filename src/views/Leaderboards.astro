---
import LeaderboardTable from '../components/LeaderboardTable.astro';
import LiveBadge from '../components/LiveBadge.astro';
import Sparkline from '../components/Sparkline.astro';
import AdSlot from '../components/AdSlot.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';
import { formatNumber, formatCompact } from '../lib/paths';
import lb from '../data/leaderboard.json';
import mobileData from '../data/mobile.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const data: any = lb;
const mobile: any = mobileData;
const ko = lang === 'ko';
const entries = data.entries ?? [];
---

<div class="wrap">
  <header class="page-head">
    <div class="row-between">
      <div>
        <p class="eyebrow">{t('home.liveNow')}</p>
        <h1>{t('lb.title')}</h1>
      </div>
      <LiveBadge updated={data.updated} stale={data._stale} sample={data._sample} dataset="leaderboard" />
    </div>
    <p class="lede">{t('lb.sub')}</p>
  </header>

  {data.metric === 'peak' && (
    <aside class="callout metric-warning">
      <p class="callout-title">⚠ Showing peak, not live</p>
      <p>
        Steam's live-concurrents endpoint did not respond on the last refresh, so these figures are
        the <strong>weekly peak</strong> for each game rather than players online right now. They
        will return to live numbers on the next successful refresh.
      </p>
    </aside>
  )}

  {entries.length > 0 && (
    <div class="stat-row">
      <div class="stat">
        <span class="stat-label">{t('lb.total')}</span>
        <strong class="stat-value">{formatNumber(data.totalPlayers ?? 0, lang)}</strong>
      </div>
      <div class="stat">
        <span class="stat-label">#1</span>
        <strong class="stat-value">{entries[0].name}</strong>
        <span class="stat-sub">{formatCompact(entries[0].current, lang)} {t('lb.players').toLowerCase()}</span>
      </div>
      <div class="stat">
        <span class="stat-label">{t('lb.risers')}</span>
        <strong class="stat-value">{data.risers?.[0]?.name ?? '—'}</strong>
        {data.risers?.[0] && (
          <span class="stat-sub text-up">+{data.risers[0].change24h?.toFixed(1)}% / 24h</span>
        )}
      </div>
      <div class="stat">
        <span class="stat-label">{t('lb.fallers')}</span>
        <strong class="stat-value">{data.fallers?.[0]?.name ?? '—'}</strong>
        {data.fallers?.[0] && (
          <span class="stat-sub text-down">{data.fallers[0].change24h?.toFixed(1)}% / 24h</span>
        )}
      </div>
    </div>
  )}

  {entries.length === 0 ? (
    <p class="callout">{t('live.never')}</p>
  ) : (
    <>
      <LeaderboardTable entries={entries} />

      <AdSlot slot="inArticle" />

      {/* Hidden until at least one refresh cycle has produced a 24h comparison —
          an empty "Biggest movers" heading looks broken rather than pending. */}
      {(data.risers?.length > 0 || data.fallers?.length > 0) && (
      <section class="movers">
        <div class="section-head"><h2>{t('lb.movers')}</h2></div>
        <div class="mover-cols">
          <div>
            <h3 class="mover-head text-up">▲ {t('lb.risers')}</h3>
            <ul role="list" class="mover-list">
              {(data.risers ?? []).map((e: any) => (
                <li>
                  <img src={e.image} alt="" width="40" height="19" loading="lazy" />
                  <span class="truncate">{e.name}</span>
                  <Sparkline values={e.spark ?? []} width={54} height={18} label="" />
                  <strong class="text-up">+{e.change24h?.toFixed(1)}%</strong>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="mover-head text-down">▼ {t('lb.fallers')}</h3>
            <ul role="list" class="mover-list">
              {(data.fallers ?? []).map((e: any) => (
                <li>
                  <img src={e.image} alt="" width="40" height="19" loading="lazy" />
                  <span class="truncate">{e.name}</span>
                  <Sparkline values={e.spark ?? []} width={54} height={18} label="" />
                  <strong class="text-down">{e.change24h?.toFixed(1)}%</strong>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
      )}
    </>
  )}

  {/* ---------- Mobile ---------- */}
  {mobile.charts && Object.keys(mobile.charts).length > 0 && (
    <section class="mt-7">
      <div class="section-head">
        <div>
          <span class="eyebrow">{ko ? '앱스토어 순위' : 'App Store chart'}</span>
          <h2>{ko ? '모바일 게임' : 'Mobile games'}</h2>
        </div>
        <span class="badge badge-warn">{ko ? '접속자 수 아님' : 'not a player count'}</span>
      </div>
      <p class="mobile-note">{mobile.note}</p>
      <div class="mobile-cols">
        {Object.entries(mobile.charts).map(([cc, chart]: [string, any]) => (
          <div>
            <h3 class="store-head">{chart.label} · {ko ? '무료 인기' : 'Top free'}</h3>
            <ol role="list" class="mobile-list">
              {(chart['top-free'] ?? []).slice(0, 10).map((g: any) => (
                <li>
                  <span class="m-rank">{g.rank}</span>
                  <img src={g.artwork} alt="" width="34" height="34" loading="lazy" />
                  <span class="m-name">
                    <a href={g.url} rel="noopener nofollow" target="_blank">{g.name}</a>
                    <span class="m-artist">{g.artist}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
      {!mobile.androidAvailable && (
        <p class="fine">
          {ko
            ? 'Google Play는 공개 API가 전혀 없어 안드로이드 순위는 포함하지 못했습니다. 관련 API는 모두 유료 third-party 스크래퍼입니다.'
            : 'Android is absent because Google Play publishes no public API of any kind — every "Play top charts API" is a paid third-party scraper.'}
        </p>
      )}
    </section>
  )}

  <aside class="method callout">
    <p class="callout-title">Methodology</p>
    <p>
      Rankings come from Valve's public <code>ISteamChartsService</code> endpoint and are refreshed
      every 30 minutes by an automated job. The 24-hour change compares against the oldest sample
      we hold from more than 24 hours ago; sparklines show up to 8 days of history at 30-minute
      resolution. {t('lb.note')}
    </p>
    <p class="src">
      Source: <a href={data.sourceUrl} rel="noopener nofollow">Steam Web API</a>
    </p>
  </aside>
</div>

<style>
  .page-head { margin-bottom: var(--space-6); }
  .page-head h1 { margin-block: 0.1em 0.3em; }
  .eyebrow { font-size: var(--step--1); color: var(--text-mute); text-transform: uppercase; letter-spacing: 0.09em; font-weight: 620; }

  .stat-row {
    display: grid; gap: var(--space-3); margin-bottom: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
  }
  .stat {
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: var(--radius); padding: var(--space-4);
    display: flex; flex-direction: column; gap: 0.15rem; min-width: 0;
  }
  .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-mute); font-weight: 640; }
  .stat-value { font-size: var(--step-1); font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .stat-sub { font-size: var(--step--1); color: var(--text-dim); }

  .movers { margin-top: var(--space-7); }
  .mover-cols { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  .mover-head { font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-3); }
  .mover-list { display: flex; flex-direction: column; gap: 0.1rem; }
  .mover-list li {
    display: grid; grid-template-columns: 40px 1fr auto auto; align-items: center; gap: var(--space-3);
    padding: var(--space-2) var(--space-3); border-radius: var(--radius-sm); font-size: var(--step--1);
  }
  .mover-list li:nth-child(odd) { background: var(--bg-elev); }
  .mover-list img { border-radius: 3px; }
  .mover-list strong { font-variant-numeric: tabular-nums; }

  .metric-warning { margin-bottom: var(--space-5); border-left-color: var(--warn); }
  .metric-warning .callout-title { color: var(--warn); }
  .mobile-note { font-size: var(--step--1); color: var(--text-dim); margin-bottom: var(--space-4); max-width: 70ch; }
  .mobile-cols { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); }
  .store-head { font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-mute); font-weight: 660; margin-bottom: var(--space-3); }
  .mobile-list { display: flex; flex-direction: column; }
  .mobile-list li { display: grid; grid-template-columns: 1.6rem 34px 1fr; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-2); border-radius: var(--radius-sm); }
  .mobile-list li:nth-child(odd) { background: var(--bg-elev); }
  .m-rank { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--text-mute); font-size: var(--step--1); }
  .mobile-list img { border-radius: 8px; background: var(--bg-inset); }
  .m-name { display: flex; flex-direction: column; min-width: 0; }
  .m-name a { color: var(--text); text-decoration: none; font-weight: 570; font-size: 0.88rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .m-name a:hover { color: var(--brand); }
  .m-artist { font-size: 0.7rem; color: var(--text-mute); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fine { font-size: 0.76rem; color: var(--text-mute); margin-top: var(--space-4); line-height: 1.6; max-width: 78ch; }
  .method { margin-top: var(--space-7); }
  .method p + p { margin-top: var(--space-3); }
  .method .src { font-size: var(--step--1); color: var(--text-mute); }
</style>
