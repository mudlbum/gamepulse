---
import '../styles/global.css';
import ThemeScript from '../components/ThemeScript.astro';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../config';
import { getLangFromUrl } from '../i18n/ui';
import { href } from '../lib/paths';

export interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  author?: string;
  section?: string;
  tags?: string[];
  noindex?: boolean;
  nofollow?: boolean;
  schema?: Record<string, unknown>[];
  faq?: { q: string; a: string }[];
  breadcrumbs?: { name: string; url: string }[];
  wide?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const { wide = false, ...seo } = Astro.props;
const ads = SITE.adsense;
---

<!doctype html>
<html lang={lang === 'ko' ? 'ko-KR' : 'en-US'} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ThemeScript />

    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <meta name="theme-color" content="#0a0c10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfcfe" media="(prefers-color-scheme: light)" />

    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
    <link rel="dns-prefetch" href="https://cdn.akamai.steamstatic.com" />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — English`} href={href('/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — 한국어`} href={href('/ko/rss.xml')} />

    <Seo {...seo} lang={lang} />

    {ads.enabled && ads.clientId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ads.clientId}`}
        crossorigin="anonymous"
      ></script>
    )}
    {SITE.analytics.plausibleDomain && (
      <script defer data-domain={SITE.analytics.plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class={wide ? '' : ''}>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
