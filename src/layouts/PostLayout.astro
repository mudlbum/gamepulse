---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import PostCard from '../components/PostCard.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { Image } from 'astro:assets';
import { useTranslations } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { localeHref, formatDate, absolute } from '../lib/paths';
import { SITE } from '../config';

export interface Props {
  post: any;
  headings: { depth: number; slug: string; text: string }[];
  related: any[];
}

const { post, headings, related } = Astro.props;
const d = post.data;
const lang: Lang = d.lang;
const t = useTranslations(lang);
const siteOrigin = Astro.site?.origin ?? SITE.url;
// Astro.url.pathname already carries the base path, so this one is safe as-is.
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const heroSrc = d.heroImage?.src ?? d.heroImageUrl;
const ogImage = typeof heroSrc === 'string' ? heroSrc : undefined;

/* NewsArticle rather than plain Article: it is the correct type for dated,
   sourced reporting, and it is what Google Discover and news surfaces look for.
   citation[] is what carries our source list into the structured data. */
/* Everything dated and reported is a NewsArticle; only evergreen formats are
   plain Article. Category here doubles as a section label (console/pc/mobile),
   so switching on it directly would mis-type most reporting. */
const EVERGREEN = new Set(['guide', 'review', 'opinion']);
const articleSchema = {
  '@type': EVERGREEN.has(d.category) ? 'Article' : 'NewsArticle',
  '@id': `${canonical}#article`,
  headline: d.title.slice(0, 110),
  description: d.description,
  inLanguage: lang === 'ko' ? 'ko-KR' : 'en-US',
  datePublished: new Date(d.pubDate).toISOString(),
  dateModified: new Date(d.updatedDate ?? d.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: d.author,
    url: new URL(localeHref('/about', lang), siteOrigin).toString(), // localeHref adds the base
  },
  publisher: { '@id': `${absolute('/', siteOrigin)}#organization` },
  mainEntityOfPage: { '@id': `${canonical}#webpage` },
  ...(ogImage ? { image: [ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteOrigin).toString()] } : {}),
  ...(d.keyTakeaway ? { abstract: d.keyTakeaway } : {}),
  articleSection: d.category,
  keywords: [...(d.tags ?? []), ...(d.games ?? [])].join(', '),
  ...(d.sources?.length
    ? { citation: d.sources.map((s: any) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })) }
    : {}),
  ...(d.games?.length
    ? { about: d.games.map((g: string) => ({ '@type': 'VideoGame', name: g })) }
    : {}),
};

const breadcrumbs = [
  { name: t('nav.home'), url: localeHref('/', lang) },
  { name: t('nav.news'), url: localeHref('/news', lang) },
  { name: d.title, url: Astro.url.pathname },
];
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  type="article"
  image={ogImage}
  imageAlt={d.heroImageAlt}
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate ?? d.pubDate}
  author={d.author}
  section={d.category}
  tags={[...(d.tags ?? []), ...(d.games ?? [])]}
  schema={[articleSchema]}
  faq={d.faq}
  breadcrumbs={breadcrumbs}
>
  <article class="wrap article">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={localeHref('/', lang)}>{t('nav.home')}</a>
      <span aria-hidden="true">/</span>
      <a href={localeHref('/news', lang)}>{t('nav.news')}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{d.category}</span>
    </nav>

    <header class="article-head">
      <div class="tags-row">
        <span class="badge badge-brand">{d.category}</span>
        {d.games?.map((g: string) => <span class="badge">{g}</span>)}
        {d.platforms?.map((p: string) => <span class="badge">{p}</span>)}
      </div>
      <h1>{d.title}</h1>
      <p class="standfirst">{d.description}</p>
      <div class="byline">
        <span>{t('post.by')} <strong>{d.author}</strong></span>
        <span aria-hidden="true">·</span>
        <time datetime={new Date(d.pubDate).toISOString()}>{formatDate(d.pubDate, lang)}</time>
        {d.updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>{t('post.updated')} <time datetime={new Date(d.updatedDate).toISOString()}>{formatDate(d.updatedDate, lang)}</time></span>
          </>
        )}
        {d.readingTime && (
          <>
            <span aria-hidden="true">·</span>
            <span>{d.readingTime} {t('post.min')}</span>
          </>
        )}
      </div>
      {(d.factChecked || d.aiAssisted) && (
        <div class="transparency">
          {d.factChecked && <span class="tr-item ok">✓ {t('post.factChecked')}</span>}
          {d.aiAssisted && <span class="tr-item">ⓘ {t('post.aiAssisted')}{d.reviewedBy ? ` — ${d.reviewedBy}` : ''}</span>}
        </div>
      )}
    </header>

    {(d.heroImage || d.heroImageUrl) && (
      <figure class="hero-fig">
        {d.heroImage ? (
          <Image src={d.heroImage} alt={d.heroImageAlt ?? ''} widths={[720, 1200]} sizes="(max-width: 1200px) 100vw, 1200px" loading="eager" />
        ) : (
          <img src={d.heroImageUrl} alt={d.heroImageAlt ?? ''} loading="eager" decoding="async" />
        )}
        {d.heroImageCredit && <figcaption>{d.heroImageCredit}</figcaption>}
      </figure>
    )}

    <div class="article-grid">
      <div class="article-main">
        {d.keyTakeaway && (
          <aside class="callout takeaway">
            <p class="callout-title">{t('post.takeaway')}</p>
            <p>{d.keyTakeaway}</p>
          </aside>
        )}

        <div class="prose">
          <slot />
        </div>

        {d.videoIds?.length > 0 && (
          <section class="videos">
            <h2>{lang === 'ko' ? '관련 영상' : 'Watch'}</h2>
            <div class="video-grid">
              {d.videoIds.map((id: string) => (
                <YouTubeEmbed id={id} title={d.title} />
              ))}
            </div>
          </section>
        )}

        {d.faq?.length > 0 && (
          <section class="faq">
            <h2>{t('post.faq')}</h2>
            {d.faq.map((f: any) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        {d.sources?.length > 0 && (
          <section class="sources">
            <h2>{t('post.sources')}</h2>
            <ol role="list">
              {d.sources.map((s: any) => (
                <li>
                  <a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a>
                  {s.publisher && <span class="pub"> — {s.publisher}</span>}
                  {s.accessed && <span class="acc"> ({lang === 'ko' ? '확인' : 'accessed'} {s.accessed})</span>}
                </li>
              ))}
            </ol>
          </section>
        )}

        {d.tags?.length > 0 && (
          <div class="tag-foot">
            <span class="tag-label">{t('post.tags')}:</span>
            {d.tags.map((tag: string) => <span class="badge">{tag}</span>)}
          </div>
        )}

        <AdSlot slot="inArticle" />
      </div>

      <aside class="article-side">
        {toc.length > 2 && (
          <nav class="toc" aria-label={t('post.toc')}>
            <h2>{t('post.toc')}</h2>
            <ul role="list">
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'sub' : ''}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <AdSlot slot="sidebar" />
      </aside>
    </div>

    {related.length > 0 && (
      <section class="related">
        <div class="section-head"><h2>{t('post.related')}</h2></div>
        <div class="grid grid-auto">
          {related.map((p: any) => <PostCard post={p} size="sm" />)}
        </div>
      </section>
    )}

    <p class="back">
      <a href={localeHref('/news', lang)}>← {t('post.backTo')}</a>
    </p>
  </article>
</BaseLayout>

<style>
  .article { max-width: 1040px; }
  /* The grid column already constrains measure; the extra 68ch cap inside it
     just left dead space to the right of every paragraph. */
  .article-main :global(.prose) { max-width: 74ch; }
  .crumbs { display: flex; gap: 0.5rem; font-size: var(--step--1); color: var(--text-mute); margin-bottom: var(--space-5); flex-wrap: wrap; }
  .crumbs a { color: var(--text-mute); text-decoration: none; }
  .crumbs a:hover { color: var(--brand); }

  .article-head { max-width: 44rem; margin-bottom: var(--space-6); }
  .tags-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: var(--space-4); }
  .article-head h1 { font-size: var(--step-5); letter-spacing: -0.033em; margin-bottom: var(--space-4); }
  .standfirst { font-size: var(--step-1); color: var(--text-dim); line-height: 1.55; margin-bottom: var(--space-4); }
  .byline { display: flex; gap: 0.5rem; flex-wrap: wrap; font-size: var(--step--1); color: var(--text-mute); }
  .byline strong { color: var(--text-dim); font-weight: 620; }

  .transparency { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-top: var(--space-4); }
  .tr-item {
    font-size: 0.76rem; color: var(--text-mute);
    border: 1px solid var(--border); border-radius: var(--radius-full);
    padding: 0.25em 0.7em; background: var(--bg-elev);
  }
  .tr-item.ok { color: var(--up); border-color: color-mix(in oklab, var(--up) 30%, transparent); }

  .hero-fig { margin-bottom: var(--space-6); }
  .hero-fig img { width: 100%; border-radius: var(--radius); border: 1px solid var(--border); }
  .hero-fig figcaption { font-size: var(--step--1); color: var(--text-mute); margin-top: 0.6em; }

  .article-grid { display: grid; gap: var(--space-7); }
  @media (min-width: 1000px) { .article-grid { grid-template-columns: minmax(0, 1fr) 240px; align-items: start; } }
  .article-side { position: sticky; top: calc(var(--header-h) + var(--space-4)); }
  @media (max-width: 999px) { .article-side { position: static; } .toc { display: none; } }

  .toc h2 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-mute); font-weight: 660; margin-bottom: var(--space-3); }
  .toc ul { display: flex; flex-direction: column; gap: 0.5rem; border-left: 1px solid var(--border); padding-left: var(--space-4); }
  .toc li.sub { padding-left: var(--space-3); }
  .toc a { font-size: 0.82rem; color: var(--text-dim); text-decoration: none; line-height: 1.4; display: block; }
  .toc a:hover, .toc a.active { color: var(--brand); }

  .takeaway { margin-bottom: var(--space-6); }
  .takeaway p:not(.callout-title) { font-size: 1.02rem; line-height: 1.65; }

  .videos, .faq, .sources { margin-top: var(--space-7); max-width: 68ch; }
  .videos h2, .faq h2, .sources h2 { font-size: var(--step-2); margin-bottom: var(--space-4); }
  .video-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); }

  .faq details {
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-elev); padding: var(--space-4); margin-bottom: var(--space-3);
  }
  .faq summary { cursor: pointer; font-weight: 620; list-style: none; display: flex; justify-content: space-between; gap: var(--space-3); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--brand); font-weight: 700; flex: none; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin-top: var(--space-3); color: var(--text-dim); line-height: 1.7; }

  .sources ol { display: flex; flex-direction: column; gap: var(--space-3); counter-reset: src; }
  .sources li {
    counter-increment: src; position: relative; padding-left: 2rem;
    font-size: var(--step--1); line-height: 1.55;
  }
  .sources li::before {
    content: counter(src); position: absolute; left: 0; top: 0;
    width: 1.4rem; height: 1.4rem; border-radius: 50%;
    background: var(--bg-elev-2); border: 1px solid var(--border);
    display: grid; place-items: center; font-size: 0.68rem; font-weight: 680; color: var(--text-mute);
  }
  .sources .pub, .sources .acc { color: var(--text-mute); }

  .tag-foot { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--border); }
  .tag-label { font-size: var(--step--1); color: var(--text-mute); font-weight: 620; }

  .related { margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--border); }
  .back { margin-top: var(--space-7); }
  .back a { font-weight: 600; text-decoration: none; }
</style>

<script is:inline>
  /* Highlight the table-of-contents entry for the section currently on screen. */
  (function () {
    var links = document.querySelectorAll('.toc a');
    if (!links.length || !('IntersectionObserver' in window)) return;
    var map = new Map();
    links.forEach(function (a) {
      var id = decodeURIComponent(a.getAttribute('href').slice(1));
      var el = document.getElementById(id);
      if (el) map.set(el, a);
    });
    var obs = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (en) {
          var a = map.get(en.target);
          if (!a) return;
          if (en.isIntersecting) {
            links.forEach(function (l) { l.classList.remove('active'); });
            a.classList.add('active');
          }
        });
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 }
    );
    map.forEach(function (_a, el) { obs.observe(el); });
  })();
</script>
